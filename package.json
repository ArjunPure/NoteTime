{
  "name": "notetime",
  "productName": "NoteTip",
  "version": "1.0.4",
  "description": "Notebooks with stylus drawing, math checking, voice notes and study tools.",
  "author": "ArjunPure",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.arjunpure.notetime",
    "productName": "NoteTip",
    "files": [
      "index.html",
      "manifest.webmanifest",
      "js/**",
      "img/**",
      "desktop/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "img/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NoteTip-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NoteTip-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "img/icon-512.png",
      "category": "public.app-category.education",
      "artifactName": "NoteTip-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "img/icon-512.png",
      "category": "Education",
      "artifactName": "NoteTip-${version}-linux.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "ArjunPure",
      "repo": "NoteTip",
      "releaseType": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArjunPure/NoteTip.git"
  },
  "homepage": "https://arjunpure.github.io/NoteTip/",
  "releaseNotes": [
    "NoteTime is now NoteTip",
    "Your notebooks and settings carry over"
  ],
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
